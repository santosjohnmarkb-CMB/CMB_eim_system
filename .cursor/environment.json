{
  "name": "CMB EIM (Electron)",
  "install": "npm ci",
  "start": "pgrep -x Xvfb >/dev/null 2>&1 || (Xvfb :99 -screen 0 1400x900x24 -nolisten tcp >/tmp/xvfb.log 2>&1 &); sleep 1",
  "terminals": [
    {
      "name": "app-dev",
      "command": "DISPLAY=:99 npm run dev"
    }
  ],
  "ports": [
    {
      "name": "vite-renderer",
      "port": 5174
    }
  ]
}
